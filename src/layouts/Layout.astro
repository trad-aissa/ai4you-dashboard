---
// src/layouts/Layout.astro — shared page shell
import '../styles/site.css';

// Self-hosted fonts (better performance + no third-party requests;
// families registered: 'Instrument Serif', 'Instrument Sans Variable',
// 'JetBrains Mono Variable')
import '@fontsource/instrument-serif/latin-400.css';
import '@fontsource/instrument-serif/latin-400-italic.css';
import '@fontsource-variable/instrument-sans';
import '@fontsource-variable/instrument-sans/wght-italic.css';
import '@fontsource-variable/jetbrains-mono';

import Seo from '../components/Seo.astro';

interface Crumb { name: string; path: string }
interface Props { title: string; description?: string; path?: string; image?: string; type?: 'website' | 'article'; publishedTime?: string; breadcrumbs?: Crumb[] }
const { title, description, path, image, type, publishedTime, breadcrumbs } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      // apply saved theme before first paint (no flash)
      try { document.documentElement.dataset.theme = localStorage.getItem('a4u-theme') || 'auto'; } catch {}
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <Seo title={title} description={description} path={path} image={image} type={type} publishedTime={publishedTime} breadcrumbs={breadcrumbs} />
    <slot name="head-extra" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title="ai4you.site — AI news" href="/rss.xml" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" id="meta-theme-light" content="#FBFBFA" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" id="meta-theme-dark" content="#171614" />
    <meta name="view-transition" content="same-origin" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="masthead">
      <div class="wrap">
        <div class="top">
          <a class="brand" href="/">
            <svg class="brand-mark" viewBox="0 0 64 64" aria-hidden="true">
              <rect width="64" height="64" rx="15" class="bm-bg"></rect>
              <path d="M10 33h9l5-13 8 24 5-13h13" fill="none" class="bm-line" stroke-width="4.4" stroke-linecap="round" stroke-linejoin="round"></path>
              <circle cx="53" cy="31" r="2.8" class="bm-dot"></circle>
            </svg>
            <span class="brand-text">ai4you<em> · the AI wire</em></span>
          </a>
          <div class="meta">
            <span id="masthead-date">—</span><br />
            Independent &amp; reader-supported
          </div>
        </div>
        <nav aria-label="Main">
          <a href="/" aria-current={Astro.url.pathname === '/' ? 'page' : undefined}>Latest</a>
          <a href="/news" aria-current={Astro.url.pathname === '/news' ? 'page' : undefined}>Headlines</a>
          <a href="/tools" aria-current={Astro.url.pathname === '/tools' ? 'page' : undefined}>Tools</a>
          <a href="/learn" aria-current={Astro.url.pathname.startsWith('/learn') ? 'page' : undefined}>Learn</a>
          <a href="/changelog" aria-current={Astro.url.pathname === '/changelog' ? 'page' : undefined}>Updates</a>
          <a href="/article" aria-current={Astro.url.pathname === '/article' ? 'page' : undefined}>Deep dive</a>
          <a href="/about" aria-current={Astro.url.pathname === '/about' ? 'page' : undefined}>About</a>

          <div class="theme-switch" role="group" aria-label="Color theme">
            <button type="button" data-set-theme="light" aria-pressed="false" aria-label="Light theme">
              <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.2"></circle><path d="M12 2.5v2.4M12 19.1v2.4M2.5 12h2.4M19.1 12h2.4M5 5l1.7 1.7M17.3 17.3 19 19M19 5l-1.7 1.7M6.7 17.3 5 19"></path></svg>
            </button>
            <button type="button" data-set-theme="auto" aria-pressed="true" aria-label="Follow system theme">
              <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8.5"></circle><path d="M12 3.5v17M12 3.5a8.5 8.5 0 0 1 0 17" fill="currentColor" stroke="none"></path></svg>
            </button>
            <button type="button" data-set-theme="dark" aria-pressed="false" aria-label="Dark theme">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 13.2A8.5 8.5 0 1 1 10.8 4a6.9 6.9 0 0 0 9.2 9.2z"></path></svg>
            </button>
          </div>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer>
      <div class="wrap">
        <div class="cols">
          <div>
            <div class="f-brand">ai4you.site</div>
            <p>A calm, sourced briefing on artificial intelligence. We link to primary sources for every story, and we label every affiliate link.</p>
          </div>
          <div>
            <h4>Sections</h4>
            <ul>
              <li><a href="/">Latest</a></li>
              <li><a href="/news">Headlines</a></li>
              <li><a href="/tools">Tool shelf</a></li>
              <li><a href="/best-writing-tools">Best writing tools</a></li>
              <li><a href="/learn">Learn by doing</a></li>
              <li><a href="/changelog">Claude Code & Codex updates</a></li>
              <li><a href="/stories">Story archive</a></li>
              <li><a href="/article">Deep dive</a></li>
              <li><a href="/about">About</a></li>
              <li><a href="/rss.xml">RSS feed</a></li>
            </ul>
          </div>
          <div>
            <h4>Trust</h4>
            <ul>
              <li><a href="/about#disclosure">Affiliate disclosure</a></li>
              <li><a href="/about#privacy">Privacy</a></li>
              <li><a href="/about#standards">Editorial standards</a></li>
              <li><a href="/terms">Terms of use</a></li>
            </ul>
          </div>
        </div>
        <div class="baseline">
          <span>© <span class="js-year">2026</span> ai4you.site</span>
          <span class="disc">Disclosure: some outbound links may earn us a commission. News items link to their original publishers. · v2.0.1</span>
        </div>
      </div>
    </footer>

    <button type="button" class="to-top" id="to-top" aria-label="Back to top" hidden>
      <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 13V3M3.5 7.5 8 3l4.5 4.5"></path></svg>
    </button>

    <script>
      // masthead date + footer year (vanilla, tiny)
      const d = document.getElementById('masthead-date');
      if (d) d.textContent = new Date().toLocaleDateString('en-US', { weekday: 'short', month: 'long', day: 'numeric', year: 'numeric' });
      document.querySelectorAll('.js-year').forEach((n) => (n.textContent = String(new Date().getFullYear())));

      // theme switcher: auto (follow OS) / light / dark, persisted
      const metaLight = document.getElementById('meta-theme-light');
      const metaDark = document.getElementById('meta-theme-dark');
      const applyTheme = (t) => {
        document.documentElement.dataset.theme = t;
        try { localStorage.setItem('a4u-theme', t); } catch {}
        for (const b of document.querySelectorAll('[data-set-theme]')) {
          b.setAttribute('aria-pressed', String(b.dataset.setTheme === t));
        }
        const forcedDark = t === 'dark', forcedLight = t === 'light';
        if (metaLight) metaLight.content = forcedDark ? '#171614' : '#FBFBFA';
        if (metaDark) metaDark.content = forcedLight ? '#FBFBFA' : '#171614';
      };
      let saved = null;
      try { saved = localStorage.getItem('a4u-theme'); } catch {}
      applyTheme(saved === 'light' || saved === 'dark' ? saved : 'auto');
      for (const b of document.querySelectorAll('[data-set-theme]')) {
        b.addEventListener('click', () => applyTheme(b.dataset.setTheme));
      }

      // back-to-top
      const toTop = document.getElementById('to-top');
      if (toTop) {
        addEventListener('scroll', () => { toTop.hidden = scrollY < 700; }, { passive: true });
        toTop.addEventListener('click', () => scrollTo({ top: 0, behavior: 'smooth' }));
      }

      // scroll-reveal: elements fade-up as they enter the viewport.
      // Classes are added via JS only, so no-JS visitors see everything.
      const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reduced && 'IntersectionObserver' in window) {
        const targets = document.querySelectorAll(
          '.feed-card, .dir-card, .today-item, .side-story, .fi-item, .cl-release, .cs-card, .rs-card, .news-item, .tool-cards .lu, .prose > section, .lr-progress'
        );
        targets.forEach((el) => el.classList.add('a4u-reveal'));
        const io = new IntersectionObserver((entries) => {
          for (const en of entries) {
            if (en.isIntersecting) { en.target.classList.add('a4u-in'); io.unobserve(en.target); }
          }
        }, { rootMargin: '0px 0px -8% 0px' });
        targets.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
