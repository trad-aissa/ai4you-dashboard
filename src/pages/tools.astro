---
// src/pages/tools.astro — DB-driven tool shelf with static fallback
import Layout from '../layouts/Layout.astro';
import { supabase } from '../lib/supabase.js';
import toolsStatic from '../data/tools.js';
import { REVIEWED } from '../config.js';
import ModelMatrix from '../components/ModelMatrix.astro';
import TokenCalculator from '../components/TokenCalculator.astro';

// The shelf is two things joined: live affiliate placements from the database
// (dashboard -> "Show on the tool shelf"), and the curated list in
// src/data/tools.js, which we recommend but earn nothing from.
let tools = [];
let dbError = null;
try {
  const { data, error } = await supabase
    .from('link_units')
    .select('slug, label, note, url, shelf_category, commission, network')
    .eq('show_on_shelf', true)
    .eq('active', true)
    .order('created_at', { ascending: true });
  if (error) throw error;
  tools = (data ?? []).map((u) => ({
    id: u.slug,
    name: u.label,
    category: u.shelf_category ?? 'productivity',
    blurb: u.note ?? '',
    terms: { commission: u.commission || null, network: u.network || null },
    url: u.url,
    affiliate: true, // shelf items come from link_units => affiliate-tagged by definition
  }));
} catch (e) {
  console.error('[tools] failed to load shelf from DB:', e?.message ?? e);
  dbError = true;
}
// Ids never collide (database ids are link_units slugs), and a curated tool
// "graduates" by getting a link_units row — the database entry then wins.
const dbIds = new Set(tools.map((t) => t.id));
tools = [...tools, ...toolsStatic.filter((t) => !dbIds.has(t.id))];

const paidCount = tools.filter((t) => t.affiliate).length;

// Only offer filters that actually match a card on the shelf — a category chip
// that empties the grid reads as a broken page.
const CATEGORIES = {
  writing: 'Writing',
  video: 'Video & audio',
  seo: 'SEO',
  marketing: 'Marketing',
  productivity: 'Productivity',
};
const present = new Set(tools.map((t) => t.category));
const cats = [
  { id: 'all', label: 'All' },
  ...Object.entries(CATEGORIES).filter(([id]) => present.has(id)).map(([id, label]) => ({ id, label })),
];
---

<Layout title="The tool shelf — AI tools worth paying for · ai4you.site" path="/tools" description="A curated shelf of AI tools. Most of them pay us nothing — the few that do are labelled on the card, with the rate printed." breadcrumbs={[{ name: 'Tool shelf', path: '/tools' }]}>
  <section class="tools-hero wrap">
    <span class="kicker">Curated · terms checked {REVIEWED}</span>
    <h1>The tool shelf.</h1>
    <p class="lede">
      Every tool here earns its place on merit. <strong>Most of them pay us nothing.</strong> Where we
      do have an affiliate deal the card says so and prints what it pays — and you pay the same
      either way.
    </p>
    <div class="affiliate-note" style="margin-top:28px;">
      <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 1.5 14.5 13.5h-13L8 1.5zM8 6.5v3M8 11.5v.01"/></svg>
      <span>
        <b>Affiliate disclosure:</b> {paidCount === 1
          ? `1 of the ${tools.length} tools below is an affiliate link`
          : `${paidCount} of the ${tools.length} tools below are affiliate links`}, marked on the
        card — if you subscribe through one we may earn a commission, at no extra cost to you.
        The rest are plain recommendations that earn us nothing.
        <a href="/about#disclosure">Read the full disclosure</a>.
      </span>
    </div>
  </section>

  <section class="dir wrap" aria-label="Tools directory">
    {cats.length > 2 && (
      <div class="filters" id="tool-filters" role="group" aria-label="Filter tools by category">
        {cats.map((c, i) => (
          <button class:list={['filter-btn', { 'is-active': i === 0 }]} data-filter={c.id} aria-pressed={i === 0 ? 'true' : 'false'}>
            {c.label}
          </button>
        ))}
      </div>
    )}
    <h2 class="visually-hidden">Tools on the shelf</h2>
    <div class="dir-grid" id="dir-grid">
      {tools.map((t) => (
        <article class="dir-card" data-cat={t.category}>
          <div class="dir-top">
            <h3>{t.name}</h3>
            {t.affiliate && t.terms?.commission && <span class="rate">{t.terms.commission}</span>}
          </div>
          <p class="dir-body">{t.blurb}</p>
          {t.affiliate && (t.terms?.commission || t.terms?.network) && (
            <div class="dir-terms">
              {t.terms?.commission && <span class="term">Commission: {t.terms.commission}</span>}
              {t.terms?.network && <span class="term">Network: {t.terms.network}</span>}
            </div>
          )}
          <a
            class="btn btn--primary"
            href={t.url}
            target="_blank"
            rel={t.affiliate ? 'sponsored nofollow noopener' : 'noopener noreferrer'}
          >
            Try {t.name}
            <span class="arrow"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"/></svg></span>
          </a>
          <p class="disclosure-mini">
            {t.affiliate
              ? 'Affiliate link — we may earn a commission at no extra cost to you.'
              : 'Plain link — no affiliate deal here, we earn nothing if you sign up.'}
          </p>
        </article>
      ))}
    </div>
    <p class="feed-status hidden" id="tool-status" role="status"></p>
    {dbError && (
      <p class="feed-status" style="margin-top:20px;">
        Showing the curated starter shelf — live shelf sync is temporarily unavailable.
      </p>
    )}
  </section>

  <div class="wrap">
    <ModelMatrix />
    <TokenCalculator title="Interactive Token Cost Comparison" subtitle="Calculate inference costs for tool automation, coding agents, and batch workflows." />
  </div>

  <section class="wrap" style="padding-bottom:72px;" aria-label="How we pick tools">
    <div class="section-head"><h2>How tools get on the shelf</h2></div>
    <ul class="checklist">
      <li><span class="n">1</span><span><b>Real use first.</b> We only list tools we'd recommend to a friend — affiliate program or not.</span></li>
      <li><span class="n">2</span><span><b>Terms in the open.</b> Where a tool pays us, the card prints the rate. Where it doesn't, the card says so too — most of this shelf earns us nothing.</span></li>
      <li><span class="n">3</span><span><b>No pay-to-rank.</b> Vendors cannot buy placement. Sponsored placements, if ever, will be labeled as such.</span></li>
      <li><span class="n">4</span><span><b>Labeled links, always.</b> Every affiliate link is tagged <code>rel="sponsored"</code> and disclosed next to the button.</span></li>
    </ul>
  </section>
</Layout>

<script>
  const bar = document.getElementById('tool-filters');
  bar?.addEventListener('click', (e) => {
    const btn = e.target.closest('.filter-btn');
    if (!btn) return;
    for (const b of bar.querySelectorAll('.filter-btn')) {
      const active = b === btn;
      b.classList.toggle('is-active', active);
      b.setAttribute('aria-pressed', String(active));
    }
    const f = btn.dataset.filter;
    let shown = 0;
    for (const card of document.querySelectorAll('#dir-grid .dir-card')) {
      const show = f === 'all' || card.dataset.cat === f;
      card.style.display = show ? '' : 'none';
      if (show) shown++;
    }
    const status = document.getElementById('tool-status');
    if (status) {
      status.textContent = shown ? '' : 'Nothing on the shelf in this category yet — check back soon.';
      status.classList.toggle('hidden', shown > 0);
    }
  });
</script>
