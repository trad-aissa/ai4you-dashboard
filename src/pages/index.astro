---
// src/pages/index.astro — homepage (build-time rendered)
import { getActiveUnits } from '../lib/supabase.js';
import { renderUnit, bindUnits } from '../lib/link-units.js';
import Layout from '../layouts/Layout.astro';
import NewsFeed from '../components/NewsFeed.astro';
import PreferredSources from '../components/PreferredSources.astro';
import TokenCalculator from '../components/TokenCalculator.astro';
import headlines from '../data/auto/headlines.json';

let units = [];
let dbError = null;
try {
  units = await getActiveUnits();
} catch (e) {
  console.error('[index] failed to load link units:', e?.message ?? e);
  dbError = true;
}
const byslug = Object.fromEntries(units.map((u) => [u.slug, u]));
---

<Layout title="ai4you.site — AI news, model releases & tools, minus the hype" path="/" description="A calm, sourced briefing on AI: every frontier-model release, price change and industry move — plus the AI tools actually worth your money.">
  <section class="hero wrap reveal">
    <span class="eyebrow"><span class="dot"></span>Independent · reader-supported · sourced</span>
    <h1>The model race, <em>decoded</em> for busy humans.</h1>
    <p class="lede">
      We track every frontier-model release, price change and industry shockwave — then point you at
      the handful of AI tools actually worth your money. News first, no hype.
    </p>
    <div class="btn-row">
      <a class="btn btn--primary" href="/tools">Browse the tool shelf</a>
      <a class="btn btn--ghost" href="/about">How we make money</a>
    </div>
    <svg class="hero-pulse" viewBox="0 0 1040 56" aria-hidden="true" preserveAspectRatio="none">
      <path class="hp-base" d="M0 28h150l14-14 24 28 14-14h180l14-14 24 28 14-14h180l14-14 24 28 14-14h180l14-14 24 28 14-14h104" fill="none"></path>
      <path class="hp-run" d="M0 28h150l14-14 24 28 14-14h180l14-14 24 28 14-14h180l14-14 24 28 14-14h180l14-14 24 28 14-14h104" fill="none"></path>
      <circle class="hp-dot" cx="1006" cy="28" r="4"></circle>
    </svg>
  </section>

  <NewsFeed limit={6} />

  <div class="wrap">
    <TokenCalculator />
  </div>

  <section class="wrap" style="padding: 32px 0 48px; border-top: 1px solid var(--hairline);" aria-label="Today's AI headlines">
    <div class="section-head">
      <h2>Today's headlines</h2>
      <a class="more" href="/news">All {headlines.count} headlines →</a>
    </div>
    <div class="today-grid">
      {headlines.items.slice(0, 6).map((i) => (
        <a class="today-item" href={i.url} target="_blank" rel="noopener">
          <span class="today-src">{i.source}</span>
          <span class="today-title">{i.title}</span>
          <time class="today-when" datetime={i.date}>{new Date(i.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}</time>
        </a>
      ))}
    </div>
    <p class="src-line" style="margin-top:14px;">auto-gathered daily at 06:00 UTC from the primary labs and outlets · <a href="/news" style="color:var(--link);">browse all</a></p>
  </section>

  <section class="tools-strip wrap" aria-label="Sponsored picks">
    <div class="section-head">
      <h2>Recommended this week</h2>
    </div>
    {/* pinned favorites first, then any other active card/banner units —
        the section degrades gracefully if pins are deleted from the DB */}
    {(() => {
      const pins = ['descript-card-demo', 'weekly-deals-banner-demo'];
      const candidates = [
        ...pins.map((s) => byslug[s]).filter(Boolean),
        ...units.filter((u) => (u.type === 'card' || u.type === 'banner') && !pins.includes(u.slug)),
      ];
      return candidates.slice(0, 3).map((u) => <Fragment set:html={renderUnit(u)} />);
    })()}
  </section>

  <section class="newsletter" aria-label="Newsletter signup">
    <div class="wrap inner reveal">
      <h2>The 3-minute AI brief, <em>every weekday</em>.</h2>
      <p>Model launches, price changes and one tool worth trying — read before your coffee cools.</p>
      <form novalidate>
        <label class="visually-hidden" for="nl-email">Email address</label>
        <input id="nl-email" name="email" type="email" placeholder="you@work.com" autocomplete="email" required />
        <button class="btn btn--primary" type="submit">Get the brief</button>
      </form>
      <div style="margin-top:18px;display:flex;justify-content:center;"><PreferredSources /></div>
        <p class="form-msg" id="nl-msg" role="status" aria-live="polite"></p>
    </div>
  </section>

  {dbError && (
    <div class="wrap" style="padding-bottom:40px;">
      <p class="feed-status">Some sponsored placements are temporarily unavailable — please check back soon.</p>
    </div>
  )}
</Layout>

<script>
  import { bindUnits } from '../lib/link-units.js';
  import { subscribeEmail } from '../lib/track.js';
  bindUnits(document);

  // newsletter signup — writes to newsletter_subscribers (see supabase/upgrade-2026-08-30.sql)
  const form = document.querySelector('.newsletter form');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const input = form.querySelector('input[type="email"]');
    const msgEl = document.getElementById('nl-msg');
    const setMsg = (t, ok) => {
      if (!msgEl) return;
      msgEl.textContent = t;
      msgEl.classList.toggle('ok', ok);
      msgEl.classList.toggle('err', !ok);
    };
    const v = (input?.value ?? '').trim();
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v)) {
      setMsg('Please enter a valid email address.', false);
      return;
    }
    const btn = form.querySelector('button');
    if (btn) btn.disabled = true;
    const result = await subscribeEmail(v.toLowerCase());
    if (btn) btn.disabled = false;
    if (result === 'error') {
      setMsg("Couldn't subscribe right now — please try again in a minute.", false);
      return;
    }
    setMsg(
      result === 'duplicate'
        ? "You're already on the list — see you in the next brief."
        : 'Thanks — you are on the list. The next brief lands in your inbox.',
      true,
    );
    if (input) input.value = '';
  });
</script>
