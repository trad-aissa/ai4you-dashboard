---
// src/pages/learn/resources.astro — template packs + curated links
import Layout from '../../layouts/Layout.astro';

const templates = [
  {
    id: 'claude-md',
    name: 'Starter CLAUDE.md',
    file: 'CLAUDE.md',
    desc: 'A lean project memory: exact commands, conventions, warnings. Delete what does not apply — every line loads on every prompt.',
    code: `# CLAUDE.md — acme-app

## Stack
- Astro + TypeScript (strict) + Tailwind

## Commands
- Dev: npm run dev
- Test: npm test (vitest — run before declaring done)
- Lint: npm run lint

## Conventions
- Conventional commits (feat/fix/chore)
- Components in src/components, one concern per file
- Prefer async/await over .then chains

## Warnings
- Never edit files in generated/
- .env files are off-limits — never read or print them`,
  },
  {
    id: 'settings',
    name: 'Guardrail settings.json',
    file: '.claude/settings.json',
    desc: 'Permission allowlist + a deny rule that blocks force-pushes and env-file reads. Commit it — the whole team inherits the guardrails.',
    code: `{
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm test)",
      "Bash(git commit:*)"
    ],
    "deny": [
      "Bash(git push --force)",
      "Read(.env*)",
      "Bash(rm -rf /*)"
    ]
  }
}`,
  },
  {
    id: 'mcp',
    name: 'Starter .mcp.json',
    file: '.mcp.json',
    desc: 'Three high-value servers: GitHub (issues/PRs), Postgres (read-only SQL), Puppeteer (drive a browser). Trim to what you use — every tool costs context.',
    code: `{
  "mcpServers": {
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/"
    },
    "postgres": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-postgres", "$DATABASE_URL"],
      "readonly": true
    },
    "puppeteer": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-puppeteer"]
    }
  }
}`,
  },
  {
    id: 'workflow',
    name: 'GitHub Action: @claude on PRs',
    file: '.github/workflows/claude.yml',
    desc: 'The official claude-code-action: mention @claude in any PR or issue to ask, review or fix. Least-privilege: it can only write to branches.',
    code: `name: claude
on:
  issue_comment:
    types: [created]
  pull_request_review_comment:
    types: [created]

permissions:
  contents: write
  issues: write
  pull-requests: write

jobs:
  claude:
    if: contains(github.event.comment.body, '@claude')
    runs-on: ubuntu-latest
    steps:
      - uses: anthropics/claude-code-action@v1
        with:
          anthropic_api_key: \${{ secrets.ANTHROPIC_API_KEY }}
          allowed_tools: "Bash(git checkout:*),Bash(npm test),Edit,Read,Write"`,
  },
  {
    id: 'skill',
    name: 'Release-checklist skill',
    file: '.claude/skills/release-checklist/SKILL.md',
    desc: 'A complete, working skill: the trigger description does the routing, the body is your runbook. Adapt the steps to your release process.',
    code: `---
name: release-checklist
description: Run before cutting any release — versioning, notes, smoke tests.
---
# Release checklist

1. Bump version in package.json (strict semver, no skips)
2. Regenerate CHANGELOG.md from merged PRs since last tag
3. Run the full test suite — must pass clean, no skips
4. Smoke-test the build output locally
5. Tag vX.Y.Z and push with the tag
6. Never release on a red main branch — fix or roll back first`,
  },
  {
    id: 'agent',
    name: 'Read-only investigator agent',
    file: '.claude/agents/investigator.md',
    desc: 'The classic pair: an agent that can look everywhere but touch nothing. Pairs with a full-access implementer for safe triage-then-fix loops.',
    code: `---
name: investigator
description: Investigates bugs, failures and flaky tests. Use when root-cause analysis is needed. Read-only.
tools: [Bash, Read, Grep, Glob]
---
You are a senior debugger. Reproduce the issue first, then isolate
the minimal root cause — cite exact file paths and line numbers.

Rules:
- NEVER edit files. Investigation and findings only.
- Prefer reproduction over speculation.
- End with: root cause, evidence, suggested fix (as a diff description).`,
  },
];

const links = [
  { name: 'Claude Code — official docs', url: 'https://docs.anthropic.com/en/docs/claude-code', note: 'The authoritative reference: setup, settings, CI, security.' },
  { name: 'Claude Code — GitHub repo & changelog', url: 'https://github.com/anthropics/claude-code', note: 'Issue tracker + the changelog we mirror on our tracker.' },
  { name: 'Codex CLI — open-source repo', url: 'https://github.com/openai/codex', note: 'Rust core, releases, discussions.' },
  { name: 'Model Context Protocol', url: 'https://modelcontextprotocol.io', note: 'The MCP spec + server directory.' },
  { name: 'MCP servers catalog', url: 'https://github.com/modelcontextprotocol/servers', note: 'Reference servers: filesystem, git, postgres, puppeteer…' },
  { name: 'Our changelog tracker', url: '/changelog', note: 'Both CLIs, refreshed daily — no digging through release notes.' },
  { name: 'Our lessons', url: '/learn', note: 'Learn by doing: simulators + quizzes.' },
];
---

<Layout title="Resources — templates & starter packs for agent CLIs · ai4you.site" path="/learn/resources" description="Copy-paste starter templates for Claude Code and Codex: CLAUDE.md, guardrail settings, .mcp.json, GitHub Action, release skill and a read-only investigator agent — plus the best official links." breadcrumbs={[{ name: 'Learn', path: '/learn' }, { name: 'Resources', path: '/learn/resources' }]}>
  <section class="wrap pg-hero">
    <span class="kicker">Copy-paste starters · battle-tested defaults</span>
    <h1>Resources.</h1>
    <p class="lede">Six production-ready templates and the only external links that matter. Copy a template into your repo and you are configured.</p>
  </section>

  <section class="wrap rs-wrap" aria-label="Templates">
    <div class="rs-grid">
      {templates.map((t) => (
        <article class="rs-card">
          <div class="rs-head">
            <h2>{t.name}</h2>
            <button type="button" class="btn btn--ghost btn--small rs-copy" data-target={t.id}>Copy</button>
          </div>
          <p class="rs-file">{t.file}</p>
          <p class="rs-desc">{t.desc}</p>
          <pre class="rs-code" id={`rs-${t.id}`}><code>{t.code}</code></pre>
        </article>
      ))}
    </div>

    <h2 class="rs-h2">External links worth your time</h2>
    <ul class="rs-links">
      {links.map((l) => (
        <li>
          <a href={l.url} target={l.url.startsWith('/') ? undefined : '_blank'} rel={l.url.startsWith('/') ? undefined : 'noopener'}>
            {l.name}
          </a>
          <span>{l.note}</span>
        </li>
      ))}
    </ul>
  </section>
</Layout>

<script>
  document.addEventListener('click', async (e) => {
    const btn = e.target.closest('.rs-copy');
    if (!btn) return;
    const code = document.getElementById(btn.dataset.target)?.textContent ?? '';
    await navigator.clipboard?.writeText(code);
    btn.textContent = 'Copied ✓';
    setTimeout(() => (btn.textContent = 'Copy'), 1400);
  });
</script>

<style>
  .rs-wrap { padding-bottom: 80px; }
  .rs-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 44px; }
  .rs-card { border: 1px solid var(--hairline); background: var(--surface); border-radius: 12px; padding: 20px 22px; display: flex; flex-direction: column; }
  .rs-head { display: flex; align-items: center; gap: 10px; margin-bottom: 2px; }
  .rs-head h2 { font: 600 15.5px/1.3 var(--sans); margin: 0; }
  .rs-head .btn { margin-left: auto; }
  .rs-file { font-family: var(--mono); font-size: 11px; color: var(--pale-green-fg); margin: 2px 0 8px; }
  .rs-desc { font-size: 13px; color: var(--muted); line-height: 1.6; margin: 0 0 12px; }
  .rs-code {
    margin: auto 0 0; background: #1B1A17; color: #D9D7CF; border-radius: 8px;
    font-family: var(--mono); font-size: 11.5px; line-height: 1.6;
    padding: 14px 16px; overflow-x: auto; max-height: 340px;
  }
  .rs-h2 { font-family: var(--display); font-weight: 400; font-size: clamp(24px, 2.6vw, 32px); margin: 0 0 14px; }
  .rs-links { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--hairline); }
  .rs-links li { display: flex; gap: 14px; align-items: baseline; padding: 11px 0; border-bottom: 1px solid var(--hairline); flex-wrap: wrap; }
  .rs-links a { font: 500 14px/1.4 var(--sans); color: var(--link); text-decoration: none; }
  .rs-links a:hover { text-decoration: underline; }
  .rs-links span { font-size: 12.5px; color: var(--muted); }
  @media (max-width: 860px) { .rs-grid { grid-template-columns: 1fr; } }
</style>
