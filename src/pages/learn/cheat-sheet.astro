---
// src/pages/learn/cheat-sheet.astro — printable reference
import Layout from '../../layouts/Layout.astro';

const slash = [
  ['/init', 'Scan the project, generate CLAUDE.md'],
  ['/clear', 'Wipe conversation — fresh start'],
  ['/compact', 'Summarize session, free context'],
  ['/context', 'Show context window breakdown'],
  ['/cost', 'Session token spend'],
  ['/memory', 'Edit CLAUDE.md memory files'],
  ['/permissions', 'Manage allow/deny rules'],
  ['/agents', 'Manage subagents'],
  ['/mcp', 'MCP servers: status + tools'],
  ['/hooks', 'Configure lifecycle hooks'],
  ['/skills', 'List installed skills'],
  ['/plugin', 'Plugins & marketplaces'],
  ['help', 'List everything'],
  ['exit', 'Quit'],
];
const cli = [
  ['claude', 'Start interactive session'],
  ['claude -p "…"', 'Headless one-shot (scripts/CI)'],
  ['claude --resume', 'Reopen a previous session'],
  ['claude mcp add …', 'Register an MCP server'],
  ['codex', 'Codex interactive TUI'],
  ['codex exec "…"', 'Codex headless under sandbox'],
  ['codex --profile X', 'Use a config profile'],
  ['codex resume', 'Reopen a Codex session'],
];
const files = [
  ['CLAUDE.md', 'Project memory — loads every prompt'],
  ['CLAUDE.local.md', 'Personal overrides (gitignored)'],
  ['.claude/settings.json', 'Shared settings: permissions + hooks'],
  ['.claude/commands/', 'Custom slash commands (.md)'],
  ['.claude/agents/', 'Subagent definitions'],
  ['.claude/skills/', 'Project skills (SKILL.md)'],
  ['.mcp.json', 'MCP servers (committed)'],
  ['~/.claude/CLAUDE.md', 'Global personal memory'],
  ['AGENTS.md', 'Cross-tool memory (Codex + CC)'],
  ['~/.codex/config.toml', 'Codex settings + profiles'],
];
const modes = [
  ['Plan mode', 'Read-only — propose, change nothing'],
  ['Auto-accept edits', 'Edits apply, commands still ask'],
  ['Default', 'Ask before edits and commands'],
  ['Codex read-only', 'Look, suggest, never touch'],
  ['Codex workspace-write', 'Edit in workspace, escalate outside'],
  ['Codex full access', 'No sandbox — disposable envs only'],
];
const keys = [
  ['Shift + Tab', 'Cycle permission modes'],
  ['Esc', 'Interrupt the agent'],
  ['# + message', 'Save as memory note'],
  ['Tab (playground)', 'Complete command'],
  ['↑ / ↓ (playground)', 'Command history'],
];
---

<Layout title="Cheat sheet — Claude Code & Codex quick reference · ai4you.site" path="/learn/cheat-sheet" description="Printable quick reference for Claude Code and Codex CLI: every slash command, CLI flag, config file, permission mode and keyboard shortcut on one page." breadcrumbs={[{ name: 'Learn', path: '/learn' }, { name: 'Cheat sheet', path: '/learn/cheat-sheet' }]}>
  <section class="wrap pg-hero cs-head">
    <span class="kicker">Printable · one page · both CLIs</span>
    <h1>The cheat sheet.</h1>
    <p class="lede">Everything you reach for daily, on one page. <button type="button" class="btn btn--ghost btn--small cs-print">Print</button></p>
  </section>

  <section class="wrap cs-grid-wrap" aria-label="Reference tables">
    <div class="cs-grid">
      <div class="cs-card">
        <h2>Slash commands</h2>
        <dl>{slash.map(([k, v]) => <div><dt><code>{k}</code></dt><dd>{v}</dd></div>)}</dl>
      </div>
      <div class="cs-card">
        <h2>Terminal / CLI</h2>
        <dl>{cli.map(([k, v]) => <div><dt><code>{k}</code></dt><dd>{v}</dd></div>)}</dl>
      </div>
      <div class="cs-card">
        <h2>Files that matter</h2>
        <dl>{files.map(([k, v]) => <div><dt><code>{k}</code></dt><dd>{v}</dd></div>)}</dl>
      </div>
      <div class="cs-card">
        <h2>Modes & trust</h2>
        <dl>{modes.map(([k, v]) => <div><dt><code>{k}</code></dt><dd>{v}</dd></div>)}</dl>
      </div>
      <div class="cs-card">
        <h2>Keys</h2>
        <dl>{keys.map(([k, v]) => <div><dt><code>{k}</code></dt><dd>{v}</dd></div>)}</dl>
      </div>
      <div class="cs-card cs-more">
        <h2>Go deeper</h2>
        <ul class="cs-links">
          <li><a href="/learn">Lessons — learn by doing</a></li>
          <li><a href="/learn/playground">Playground — safe sandbox</a></li>
          <li><a href="/learn/builder">Config Builder — generate files</a></li>
          <li><a href="/learn/features">Feature index — searchable</a></li>
          <li><a href="/changelog">Changelog tracker — daily</a></li>
        </ul>
      </div>
    </div>
  </section>
</Layout>

<script>
  document.querySelector('.cs-print')?.addEventListener('click', () => window.print());
</script>

<style>
  .cs-head .btn { vertical-align: middle; margin-left: 6px; }
  .cs-grid-wrap { padding-bottom: 80px; }
  .cs-grid { columns: 2; column-gap: 20px; }
  .cs-card {
    break-inside: avoid; border: 1px solid var(--hairline); background: var(--surface);
    border-radius: 10px; padding: 18px 20px; margin-bottom: 20px;
  }
  .cs-card h2 { font: 600 13px/1.3 var(--mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); margin: 0 0 12px; }
  .cs-card dl { margin: 0; }
  .cs-card dl > div { display: flex; gap: 10px; padding: 5px 0; border-bottom: 1px dashed var(--hairline); align-items: baseline; }
  .cs-card dl > div:last-child { border-bottom: none; }
  .cs-card dt { flex: none; min-width: 130px; }
  .cs-card dd { margin: 0; font-size: 12.5px; color: var(--muted); }
  .cs-card code { font-family: var(--mono); font-size: 11.5px; color: var(--ink); background: var(--canvas); border: 1px solid var(--hairline); border-radius: 4px; padding: 1px 6px; white-space: nowrap; }
  .cs-links { list-style: none; margin: 0; padding: 0; }
  .cs-links li { padding: 5px 0; border-bottom: 1px dashed var(--hairline); }
  .cs-links li:last-child { border-bottom: none; }
  .cs-links a { font-size: 13px; color: var(--link); text-decoration: none; }
  .cs-links a:hover { text-decoration: underline; }
  @media (max-width: 860px) { .cs-grid { columns: 1; } }
  @media print {
    .masthead, footer, .cs-head .btn { display: none !important; }
    .cs-grid { columns: 2; }
    .cs-card { border-color: #ccc; }
    body { background: #fff; }
  }
</style>
