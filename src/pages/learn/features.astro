---
// src/pages/learn/features.astro — searchable feature index
import Layout from '../../layouts/Layout.astro';
import { features } from '../../data/features.js';

const TYPES = [
  { id: 'all', label: 'All' },
  { id: 'command', label: 'Commands' },
  { id: 'flag', label: 'Flags' },
  { id: 'file', label: 'Files' },
  { id: 'hook', label: 'Hooks' },
  { id: 'mode', label: 'Modes' },
  { id: 'concept', label: 'Concepts' },
  { id: 'protocol', label: 'Protocols' },
  { id: 'tool', label: 'Tools' },
];
const typeChip = (t) => ({ command: 'chip--model', file: 'chip--product', hook: 'chip--industry', mode: 'chip--research', concept: 'chip--pricing', protocol: 'chip--research', flag: 'chip--product', tool: 'chip--industry' })[t] ?? 'chip--product';
const toolLabel = (t) => (t === 'both' ? 'Claude Code + Codex' : t === 'codex' ? 'Codex' : 'Claude Code');
---

<Layout title="Feature index — every Claude Code & Codex command, flag and file · ai4you.site" path="/learn/features" description="Searchable index of every Claude Code and Codex CLI feature: commands, flags, files, hooks, modes and concepts — each linked to the lesson that teaches it." breadcrumbs={[{ name: 'Learn', path: '/learn' }, { name: 'Feature index', path: '/learn/features' }]}>
  <section class="wrap pg-hero">
    <span class="kicker">{features.length} features · searchable · linked to lessons</span>
    <h1>Feature index.</h1>
    <p class="lede">Every command, flag, file and concept from both agentic CLIs. Search, filter, and jump straight to the lesson that teaches it.</p>
  </section>

  <section class="wrap fi-wrap" aria-label="Feature index">
    <div class="fi-controls">
      <div class="cl-search">
        <svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="7" cy="7" r="4.6"></circle><path d="m10.5 10.5 3 3"></path></svg>
        <label class="visually-hidden" for="fi-q">Search features</label>
        <input id="fi-q" type="search" placeholder="Search: /compact, hooks, sandbox…" autocomplete="off" />
      </div>
      <div class="filters" id="fi-types" role="group" aria-label="Filter by type">
        {TYPES.map((t, i) => <button class:list={['filter-btn', { 'is-active': i === 0 }]} data-type={t.id} aria-pressed={i === 0 ? 'true' : 'false'}>{t.label}</button>)}
      </div>
      <div class="filters" id="fi-tools" role="group" aria-label="Filter by tool">
        <button class="filter-btn is-active" data-tool="all" aria-pressed="true">Both</button>
        <button class="filter-btn" data-tool="claude-code" aria-pressed="false">Claude Code</button>
        <button class="filter-btn" data-tool="codex" aria-pressed="false">Codex</button>
      </div>
    </div>

    <p class="fi-count" id="fi-count" role="status" aria-live="polite"></p>

    <ul class="fi-list" id="fi-list">
      {features.map((f) => (
        <li class="fi-item" data-type={f.type} data-tool={f.tool} data-text={`${f.name} ${f.desc}`.toLowerCase()}>
          <div class="fi-row">
            <code class="fi-name">{f.name}</code>
            <span class={`chip ${typeChip(f.type)}`}>{f.type}</span>
            <span class="fi-tool">{toolLabel(f.tool)}</span>
          </div>
          <p class="fi-desc">{f.desc}</p>
          {f.module && <a class="fi-lesson" href={`/learn/${f.module}`}>→ lesson: {f.module.replace(/-/g, ' ')}</a>}
        </li>
      ))}
    </ul>
    <p class="feed-status hidden" id="fi-empty" role="status">No features match — try a different search.</p>
  </section>
</Layout>

<script>
  const q = document.getElementById('fi-q');
  let type = 'all';
  let tool = 'all';

  function apply() {
    const needle = (q?.value ?? '').trim().toLowerCase();
    let shown = 0;
    for (const el of document.querySelectorAll('.fi-item')) {
      const okType = type === 'all' || el.dataset.type === type;
      const okTool = tool === 'all' || el.dataset.tool === tool || el.dataset.tool === 'both';
      const okText = !needle || el.dataset.text.includes(needle);
      const show = okType && okTool && okText;
      el.style.display = show ? '' : 'none';
      if (show) shown++;
    }
    document.getElementById('fi-count').textContent = `${shown} of ${document.querySelectorAll('.fi-item').length} features`;
    document.getElementById('fi-empty').classList.toggle('hidden', shown > 0);
  }

  q?.addEventListener('input', apply);
  for (const scope of [['#fi-types', 'type'], ['#fi-tools', 'tool']]) {
    const [sel, key] = scope;
    const bar = document.querySelector(sel);
    bar?.addEventListener('click', (e) => {
      const btn = e.target.closest('.filter-btn');
      if (!btn) return;
      for (const b of bar.querySelectorAll('.filter-btn')) {
        const active = b === btn;
        b.classList.toggle('is-active', active);
        b.setAttribute('aria-pressed', String(active));
      }
      if (key === 'type') type = btn.dataset.type;
      else tool = btn.dataset.tool;
      apply();
    });
  }
  apply();
</script>

<style>
  .fi-wrap { padding-bottom: 80px; }
  .fi-controls { display: flex; flex-direction: column; gap: 14px; margin-bottom: 16px; }
  .cl-search { position: relative; max-width: 460px; }
  .cl-search svg { position: absolute; left: 11px; top: 50%; transform: translateY(-50%); width: 14px; height: 14px; }
  .cl-search svg circle, .cl-search svg path { stroke: var(--faint); stroke-width: 1.6; fill: none; stroke-linecap: round; }
  .cl-search input { width: 100%; font: 400 13.5px/1.4 var(--sans); color: var(--ink); background: var(--surface); border: 1px solid var(--hairline-strong); border-radius: 8px; padding: 10px 12px 10px 32px; }
  .cl-search input:focus-visible { outline: 2px solid var(--ink); outline-offset: 1px; }
  .fi-controls .filters { margin-bottom: 0; }
  .fi-count { font: 500 12.5px/1.4 var(--sans); color: var(--faint); margin: 0 0 10px; min-height: 18px; }
  .fi-list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--hairline); }
  .fi-item { border-bottom: 1px solid var(--hairline); padding: 14px 0; }
  .fi-row { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .fi-name { font-family: var(--mono); font-size: 13px; font-weight: 500; color: var(--ink); background: var(--canvas); border: 1px solid var(--hairline); border-radius: 5px; padding: 2px 8px; }
  .fi-tool { font-family: var(--mono); font-size: 11px; color: var(--faint); letter-spacing: 0.04em; margin-left: auto; }
  .fi-desc { font-size: 13.5px; color: var(--muted); margin: 6px 0 0; max-width: 80ch; }
  .fi-lesson { font: 500 12px/1.4 var(--sans); color: var(--link); text-decoration: none; }
  .fi-lesson:hover { text-decoration: underline; }
</style>
