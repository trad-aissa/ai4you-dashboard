---
// src/components/NewsFeed.astro — build-time news feed with filters
// News data lives in src/data/news.js (same shape as v1 — easy to migrate).
import news from '../data/news.js';

interface Props { limit?: number }
const { limit } = Astro.props;

const items = news.items ?? [];
const shown = typeof limit === 'number' ? items.slice(0, limit) : items;
const cats = [
  { id: 'all', label: 'All' },
  { id: 'model-release', label: 'Model releases' },
  { id: 'pricing', label: 'Pricing' },
  { id: 'product', label: 'Products' },
  { id: 'industry', label: 'Industry & policy' },
];

const fmt = (iso) =>
  new Date(`${iso}T12:00:00`).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });

const chip = (c) =>
  ({ 'model-release': 'chip--model', pricing: 'chip--pricing', product: 'chip--product', research: 'chip--research', industry: 'chip--industry' })[c] ?? 'chip--product';

const label = (c) =>
  ({ 'model-release': 'Model release', pricing: 'Pricing', product: 'Product', research: 'Research', industry: 'Industry' })[c] ?? 'News';
---

<section class="briefs" role="region" aria-label="Quick briefs ticker">
  <div class="wrap briefs-inner">
    <span class="briefs-label"><span class="pulse"></span>The wire</span>
    <div class="briefs-track">
      {(news.briefs ?? []).map((b) => (
        <div class="brief-item">
          <span class="src">{b.source}</span>
          <a href={b.url} target="_blank" rel="noopener noreferrer">{b.text}</a>
          <time datetime={b.date}>{fmt(b.date)}</time>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="lead-section wrap" aria-label="Top stories">
  <div class="section-head">
    <h2>Top story</h2>
  </div>
  <div class="lead-grid">
    <article class="lead-story">
      <span class="kicker">{label(items[0]?.category)}</span>
      <h3><a href={items[0]?.url} target="_blank" rel="noopener noreferrer">{items[0]?.headline}</a></h3>
      <p>{items[0]?.summary}</p>
      {items[0]?.why && <p class="why"><b>Why it matters — </b>{items[0].why}</p>}
      <p class="src-line">source · <a href={items[0]?.url} target="_blank" rel="noopener noreferrer">{items[0]?.source_name}</a></p>
    </article>
    <aside class="side-stories" aria-label="More top stories">
      {items.slice(1, 4).map((item) => (
        <article class="side-story">
          <div class="card-meta">
            <span class={`chip ${chip(item.category)}`}>{label(item.category)}</span>
            <span class="card-date">{fmt(item.date)}</span>
          </div>
          <h4><a href={item.url} target="_blank" rel="noopener noreferrer">{item.headline}</a></h4>
          <p>{item.summary}</p>
          <p class="src-line">{item.source_name}</p>
        </article>
      ))}
    </aside>
  </div>
</section>

<section class="feed-section wrap" aria-label="Latest news feed">
  <div class="section-head">
    <h2>The latest</h2>
    {typeof limit === 'number' && items.length > limit && <a class="more" href="/stories">All {items.length} stories →</a>}
  </div>
  <div class="filters" role="group" aria-label="Filter stories by category" id="feed-filters">
    {cats.map((c, i) => (
      <button class:list={['filter-btn', { 'is-active': i === 0 }]} data-filter={c.id} aria-pressed={i === 0 ? 'true' : 'false'}>
        {c.label}
      </button>
    ))}
  </div>
  <div class="feed" id="feed-grid">
    {shown.map((item) => (
      <article class="feed-card" data-cat={item.category}>
        <div class="card-meta">
          <span class={`chip ${chip(item.category)}`}>{label(item.category)}</span>
          <span class="card-date">{fmt(item.date)}</span>
        </div>
        <h3><a href={item.url} target="_blank" rel="noopener noreferrer">{item.headline}</a></h3>
        <p>{item.summary}</p>
        <p class="src-line">source · <a href={item.url} target="_blank" rel="noopener noreferrer">{item.source_name}</a></p>
      </article>
    ))}
  </div>
  <p class="feed-status hidden" id="feed-status" role="status"></p>
</section>

<script>
  // category filter — pure CSS-class toggling over build-rendered cards
  const bar = document.getElementById('feed-filters');
  bar?.addEventListener('click', (e) => {
    const btn = e.target.closest('.filter-btn');
    if (!btn) return;
    for (const b of bar.querySelectorAll('.filter-btn')) {
      const active = b === btn;
      b.classList.toggle('is-active', active);
      b.setAttribute('aria-pressed', String(active));
    }
    const f = btn.dataset.filter;
    let shown = 0;
    for (const card of document.querySelectorAll('#feed-grid .feed-card')) {
      const show = f === 'all' || card.dataset.cat === f;
      card.style.display = show ? '' : 'none';
      if (show) shown++;
    }
    const status = document.getElementById('feed-status');
    if (status) {
      status.textContent = shown ? '' : 'No stories in this category yet — check back soon.';
      status.classList.toggle('hidden', shown > 0);
    }
  });
</script>
