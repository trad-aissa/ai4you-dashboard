---
// src/components/Seo.astro — canonical + Open Graph + Twitter cards + JSON-LD
interface Crumb { name: string; path: string }
interface Props {
  title: string;
  description?: string;
  path?: string;          // e.g. "/tools" (no trailing slash)
  image?: string;         // absolute or root-relative og image
  type?: 'website' | 'article';
  publishedTime?: string;
  breadcrumbs?: Crumb[];  // emitted as BreadcrumbList JSON-LD
}
import { OG_CARDS, ogSlug } from '../data/og-cards.js';

const { title, description, path = '', image, type = 'website', publishedTime, breadcrumbs } = Astro.props;

const SITE = 'https://www.ai4you.site';
const canonical = `${SITE}${path || '/'}`;
// Per-page card where we have copy for one (src/data/og-cards.js, rendered to
// PNG at build time by src/pages/og/[...slug].png.ts), otherwise the shared
// default. PNG because no major platform renders an SVG og:image.
const cardPath = path && OG_CARDS[path] ? `/og/${ogSlug(path)}.png` : '/og-default.png';
const ogImage = image ? (image.startsWith('http') ? image : `${SITE}${image}`) : `${SITE}${cardPath}`;
const ogImageType = ogImage.endsWith('.svg') ? 'image/svg+xml' : 'image/png';
const ogImageAlt = `${title} — ai4you.site`;
const desc = description ?? 'A calm, sourced briefing on AI: model releases, pricing changes and industry moves — plus the tools actually worth your money.';

const breadcrumbLd = breadcrumbs?.length ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [{ name: 'Home', path: '/' }, ...breadcrumbs].map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.name,
    item: `${SITE}${c.path}`,
  })),
} : null;
---

<!-- Primary -->
<link rel="canonical" href={canonical} />
<meta name="description" content={desc} />
<meta name="robots" content="index, follow, max-image-preview:large" />
<meta name="author" content="ai4you.site" />

<!-- Open Graph -->
<meta property="og:site_name" content="ai4you.site" />
<meta property="og:type" content={type} />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={desc} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:type" content={ogImageType} />
<meta property="og:image:alt" content={ogImageAlt} />
<meta property="og:locale" content="en_US" />
{publishedTime && <meta property="article:published_time" content={publishedTime} />}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={desc} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={ogImageAlt} />

<!-- Organization JSON-LD (sitewide identity) -->
<script type="application/ld+json" set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'ai4you.site',
  url: SITE,
  logo: `${SITE}/favicon.svg`,
  description: 'Independent AI news, model releases and tool recommendations.',
})} />

{breadcrumbLd && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />}
