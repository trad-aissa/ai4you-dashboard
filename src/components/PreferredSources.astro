---
// Google "Add to Preferred Sources" — deeplink only, no third-party script.
// Docs: https://developers.google.com/search/docs/appearance/preferred-sources
// The official JS embed (news.google.com/swg/js/v1/publisher.js) sets
// identifiers on every reader, which contradicts /about#privacy and forced
// three google.com entries into the CSP. The deeplink does the same job:
// it opens Google's preferences page with our domain pre-filled, works
// without JS, and needs no permission from anyone.
const DEEPLINK = 'https://www.google.com/preferences/source?q=https://www.ai4you.site/';
---

<div class="a4u-pref">
  <p class="a4u-pref-line">Like our briefing? Get us inside your Google feed.</p>
  <a class="a4u-pref-link" href={DEEPLINK} target="_blank" rel="noopener">Add ai4you.site as a preferred source in Google →</a>
</div>

<style>
  .a4u-pref { display: flex; flex-direction: column; gap: 8px; align-items: flex-start; }
  .a4u-pref-line { margin: 0; font-size: 13.5px; color: var(--muted); line-height: 1.5; }
  .a4u-pref-link { color: var(--link); text-decoration: none; font-size: 13.5px; }
  .a4u-pref-link:hover { text-decoration: underline; }
</style>
