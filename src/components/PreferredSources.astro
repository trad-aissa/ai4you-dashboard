---
// Google "Add to Preferred Sources" — OFFICIAL embed
// Docs: https://developers.google.com/search/docs/appearance/preferred-sources
// Loads https://news.google.com/swg/js/v1/publisher.js and renders
// <div google-add-preferred-source-btn></div> as a Google-styled button.
interface Props { theme?: 'light' | 'dark' }
const { theme = 'light' } = Astro.props;
---

<div class="a4u-pref">
  <p class="a4u-pref-line">Like our briefing? Get us inside your Google feed.</p>
  <div google-add-preferred-source-btn data-theme={theme}></div>
</div>

<style>
  .a4u-pref { display: flex; flex-direction: column; gap: 8px; align-items: flex-start; }
  .a4u-pref-line { margin: 0; font-size: 13.5px; color: var(--muted); line-height: 1.5; }
</style>

<script is:inline async src="https://news.google.com/swg/js/v1/publisher.js"></script>