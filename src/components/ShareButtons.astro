---
// src/components/ShareButtons.astro — plain share links (no third-party scripts:
// the CSP only allows our own JS). Usage: <ShareButtons title={t} path="/news/x" />
interface Props { title: string; path: string }
const { title, path } = Astro.props;

const url = `https://www.ai4you.site${path}`;
const u = encodeURIComponent(url);
const t = encodeURIComponent(title);
const links = [
  { name: 'X', href: `https://twitter.com/intent/tweet?url=${u}&text=${t}` },
  { name: 'LinkedIn', href: `https://www.linkedin.com/sharing/share-offsite/?url=${u}` },
  { name: 'Reddit', href: `https://www.reddit.com/submit?url=${u}&title=${t}` },
  { name: 'Hacker News', href: `https://news.ycombinator.com/submitlink?u=${u}&t=${t}` },
];
---

<div class="share" data-share-url={url} data-share-title={title}>
  <span class="share-label">Share</span>
  <ul>
    {links.map((l) => (
      <li><a href={l.href} target="_blank" rel="noopener" aria-label={`Share on ${l.name} (opens in a new tab)`}>{l.name}</a></li>
    ))}
    <li><button type="button" data-share-copy>Copy link</button></li>
    <li><button type="button" data-share-native hidden>Share…</button></li>
  </ul>
  <span class="visually-hidden" role="status" aria-live="polite" data-share-status></span>
</div>

<style>
  .share { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; margin: 28px 0; }
  .share-label { font: 500 13px/1 var(--sans); color: var(--muted); }
  .share ul { display: flex; flex-wrap: wrap; gap: 8px; list-style: none; margin: 0; padding: 0; }
  .share a, .share button {
    display: inline-flex; align-items: center; min-height: 36px; padding: 0 13px;
    font: 500 13px/1 var(--sans); color: var(--ink); text-decoration: none;
    background: var(--surface); border: 1px solid var(--hairline-strong); border-radius: 999px; cursor: pointer;
  }
  .share a:hover, .share button:hover { background: var(--hover); }
  .share a:focus-visible, .share button:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }
  .share button.is-copied { background: var(--pale-green-bg); color: var(--pale-green-fg); border-color: transparent; }
</style>

<script>
  for (const box of document.querySelectorAll<HTMLElement>('[data-share-url]')) {
    const url = box.dataset.shareUrl!, title = box.dataset.shareTitle!;
    const status = box.querySelector<HTMLElement>('[data-share-status]')!;
    const copy = box.querySelector<HTMLButtonElement>('[data-share-copy]')!;
    copy.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(url);
        copy.textContent = 'Copied'; copy.classList.add('is-copied'); status.textContent = 'Link copied';
        setTimeout(() => { copy.textContent = 'Copy link'; copy.classList.remove('is-copied'); status.textContent = ''; }, 2000);
      } catch {
        status.textContent = 'Copy failed. Copy the address from the browser bar.';
      }
    });
    const native = box.querySelector<HTMLButtonElement>('[data-share-native]')!;
    if (typeof navigator.share === 'function') {
      native.hidden = false;
      native.addEventListener('click', () => navigator.share({ title, url }).catch(() => {}));
    }
  }
</script>
